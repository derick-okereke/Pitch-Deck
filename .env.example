# Application
# Use https://pitch-deck.pxxlspace.cv in production; localhost is only for local development.
APP_BASE_URL=http://localhost:3000
# Optional local-only override. Do not set this to localhost in the deployed environment.
AUTH_EMAIL_REDIRECT_ORIGIN=http://localhost:3000
DEMO_MODE=true
DEMO_FIXTURE_MODE=false

# WatchUp — private server key. Browser failures use the authenticated server relay.
WATCHUP_API_KEY=
GIT_SHA=

# PostHog — browser project token and regional ingest host, used only after consent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Supabase — browser-safe values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server only; never expose with a NEXT_PUBLIC_ prefix
SUPABASE_SECRET_KEY=

# Groq — server only
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Azure Speech — server only; use the Speech resource's region code (for example, uksouth)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Bachs — sandbox only; all three values come from the sandbox organization.
BACHS_API_BASE_URL=https://sandbox-api.bachs.io
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_FOUNDER_PRODUCT_ID=
