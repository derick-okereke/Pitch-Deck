# Application
# Set this to the public origin of each deployment (Vercel or Pxxl).
APP_BASE_URL=http://localhost:3000
# Set this to the same deployment's public origin for signup and recovery links.
AUTH_EMAIL_REDIRECT_ORIGIN=http://localhost:3000
DEMO_MODE=true
DEMO_CATALOGUE_ENABLED=true
DEMO_FIXTURE_MODE=false

# WatchUp — private server key. Browser failures use the authenticated server relay.
WATCHUP_API_KEY=
GIT_SHA=

# PostHog — browser project token and regional ingest host, used only after consent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Supabase — browser-safe values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server only; never expose with a NEXT_PUBLIC_ prefix
SUPABASE_SECRET_KEY=

# Groq — server only
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# ElevenLabs speech — server only; use voice IDs available to your account
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_WARM=hpp4J3VqNfWAUOO0d1Us
ELEVENLABS_VOICE_DIRECT=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_VOICE_CALM=SAz9YHcvj6GT2YYXdXww

# Bachs — sandbox only; all three values come from the sandbox organization.
BACHS_API_BASE_URL=https://sandbox-api.bachs.io
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_FOUNDER_PRODUCT_ID=
